{
  "name": "mapeo-vecinal/mapeo-vecinal",
  "description": "Plataforma cívica para reportes y votaciones de barrio",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "Mapeo Vecinal Team",
      "email": "info@mapeo-vecinal.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "codeigniter4/framework": "^4.6",
    "myth/auth": "^1.2",
    "symfony/var-dumper": "^6.0"
  },
  "require-dev": {
    "codeigniter4/devkit": "^1.1",
    "phpunit/phpunit": "^9.5",
    "mikey179/vfsstream": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
