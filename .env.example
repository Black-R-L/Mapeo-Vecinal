CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.sessionDriver = 'FileHandler'
app.sessionCookieName = 'PHPSESSID'
app.sessionExpiration = 7200
app.sessionSavePath = null
app.sessionMatchIP = false
app.sessionTimeToUpdate = 300
app.sessionRegenerateDestroy = false
app.CSPEnabled = false

# ============================================================
# DATABASE
# ============================================================
database.default.hostname = localhost
database.default.database = mapeo_vecinal
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.collation = utf8mb4_unicode_ci
database.default.pConnect = false
database.default.connect_timeout = 10
database.default.strict = true
database.default.encrypt = false
database.default.compress = false
database.default.pooledConnections = false
database.default.failover = []
database.default.searchPath = false

# ============================================================
# CONTENT SECURITY POLICY
# ============================================================
CSP.styleNonceTag = false

# ============================================================
# COOKIE
# ============================================================
cookie.prefix = ""
cookie.expires = 0
cookie.path = "/"
cookie.domain = ""
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'

# ============================================================
# ENCRYPTION
# ============================================================
encryption.key = 
encryption.driver = OpenSSL

# ============================================================
# HONEYPOT
# ============================================================
honeypot.hidden = 'honeypot'
honeypot.label = 'Fill in this field'
honeypot.name = 'honeypot'
honeypot.template = '<label>{label}</label><input type="text" name="{name}" value=""/>'
honeypot.container = '<div style="display:none">{template}</div>'

# ============================================================
# SECURITY
# ============================================================
security.tokenName = 'csrf_token_name'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
security.regenerate = true
# security.redirect: no fijar a mano, el default de CI4 ya varía
# automáticamente según CI_ENVIRONMENT (false en development, true en
# production). Fijarlo en 'true' oculta errores reales incluso en desarrollo.

# ============================================================
# LOGGER
# ============================================================
logger.threshold = 4
